def analyze_string(s):
    # Handle empty string
    if len(s) == 0:
        print("Empty string provided.")
        return

    # 1. Length of string
    print("Length of string:", len(s))

    # 2. Reverse string using slicing
    print("Reversed string:", s[::-1])

    # 3. Count vowels (case-insensitive)
    vowels = "aeiou"
    count = 0

    for char in s:
        if char.lower() in vowels:
            count += 1

    print("Number of vowels:", count)

    # 4. Print characters with positive and negative index
    print("\nCharacter indexing:")
    for i in range(len(s)):
        print(f"Character: {s[i]} | Positive index: {i} | Negative index: {i - len(s)}")


# Taking user input
user_input = input("Enter a string: ")
analyze_string(user_input)